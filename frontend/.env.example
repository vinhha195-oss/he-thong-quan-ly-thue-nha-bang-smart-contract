# Sao chep file nay thanh ".env" (cung thu muc frontend/) neu muon ep buoc che do.
# Cac gia tri hop le:
#   auto  (mac dinh, khong dat bien nay) -> tu dong dung mock khi chua deploy contract
#         (frontend/src/config.js co CONTRACT_ABI rong), nguoc lai dung blockchain that.
#   true  -> luon dung du lieu mau (mock), khong can MetaMask/contract.
#   false -> luon dung blockchain that qua ethers.js + MetaMask.
VITE_USE_MOCK=true

# (Tuy chon) JWT tu tai khoan Pinata rieng cua ban (mien phi, tu dang ky tai
# pinata.cloud -> API Keys -> tao key co quyen "pinFileToIPFS") de bat nut "tai anh
# len IPFS" ngay trong form dang tin. Khong dat bien nay van dung duoc: chi can dan
# CID/URL da upload san (vd qua web UI cua Pinata/NFT.Storage) vao o nhap CID.
VITE_PINATA_JWT=
