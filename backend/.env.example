# Sao chep file nay thanh ".env" va dien dia chi RentalManager da deploy.

# URL cua node blockchain (Hardhat local hoac Sepolia RPC)
RPC_URL=http://127.0.0.1:8545

# Dia chi RentalManager (lay trong ignition/deployments/chain-<id>/deployed_addresses.json
# sau khi chay npm run deploy o thu muc goc)
MANAGER_ADDRESS=

# Block luc deploy RentalManager - indexer se bat dau quet tu block nay
DEPLOYMENT_BLOCK=0

# So block cho xac nhan truoc khi xu ly (tranh doc phai block bi reorg)
CONFIRMATIONS=1

# So block moi lan quet
BLOCK_BATCH_SIZE=500

# Chu ky quet (ms) khi chua co block moi
POLL_INTERVAL_MS=3000

# File SQLite luu du lieu da index
DB_FILE=./data/rental.sqlite3

# Cong chay REST API
PORT=3001
